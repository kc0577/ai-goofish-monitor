# 安全观察模式：关键词规则，不调用 AI，不自动轮换账号或代理。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=

SERVER_PORT=8000
WEB_USERNAME=replace-me
WEB_PASSWORD=replace-with-a-long-random-password

RUN_HEADLESS=true
LOGIN_IS_EDGE=true
PCURL_TO_MOBILE=true
SKIP_AI_ANALYSIS=true

PROXY_ROTATION_ENABLED=false
PROXY_ROTATION_RETRY_LIMIT=1
ACCOUNT_ROTATION_ENABLED=false
ACCOUNT_ROTATION_RETRY_LIMIT=1
TASK_FAILURE_THRESHOLD=1
TASK_FAILURE_PAUSE_SECONDS=86400
TASK_LOG_RETENTION_DAYS=7
